rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dueño del presupuesto o miembro (budgets/{uid}.members, que solo escribe el script de enlace)
    function canUse(budgetUid) {
      return request.auth != null && (request.auth.uid == budgetUid
        || (exists(/databases/$(database)/documents/budgets/$(budgetUid))
            && request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetUid)).data.get('members', {})));
    }

    // Cada gasto es del presupuesto de su userId (dueño o miembros) y no se puede cambiar de presupuesto
    function owns(data) {
      return canUse(data.userId);
    }

    // Autoría del gasto: opcional (una app antigua en caché no la manda), pero si viene es quien escribe
    function signedBy(d, field) {
      return !(field in d) || d[field] == request.auth.uid;
    }

    // Cuenta demo pública (botón «Entrar como Tester»): funciona en memoria y nunca escribe en Firestore.
    // Debe coincidir con DEMO_UID de src/constants/demo.ts
    function notDemo() {
      return request.auth.uid != 'jTQDmVrbmDSX657q7Of8E0O0EfK2';
    }

    // Campos de un gasto: tipos y tamaños acotados (la cuenta demo es pública, así nadie mete basura enorme)
    function okAmount(d) { return d.amount is number && d.amount > 0 && d.amount < 1000000; }
    function okConcept(d) { return d.concept is string && d.concept.size() <= 200; }
    function okDate(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function okCategory(d) { return d.category is string && d.category.size() <= 100; }
    // Devoluciones del gasto (compras en conjunto): lista acotada
    function okRefunds(d) { return d.refunds is list && d.refunds.size() <= 30; }
    function validExpense(d) {
      return okAmount(d) && okConcept(d) && okDate(d) && okCategory(d);
    }
    // Al editar solo se validan los campos que cambian: un gasto antiguo con datos raros sigue siendo editable
    function validChanges(d, changed) {
      return (!changed.hasAny(['amount']) || okAmount(d))
        && (!changed.hasAny(['concept']) || okConcept(d))
        && (!changed.hasAny(['date']) || okDate(d))
        && (!changed.hasAny(['category']) || okCategory(d))
        && (!changed.hasAny(['refunds']) || okRefunds(d))
        // Marca de foto del ticket: true o se quita
        && (!changed.hasAny(['receipt']) || !('receipt' in d) || d.receipt == true);
    }

    // Gastos apuntados a mano
    match /expenses/{id} {
      allow read: if owns(resource.data);
      allow delete: if owns(resource.data) && notDemo();
      allow create: if owns(request.resource.data) && notDemo()
        && request.resource.data.keys().hasOnly(['userId', 'amount', 'concept', 'category', 'date', 'createdAt', 'createdBy', 'updatedBy'])
        && validExpense(request.resource.data)
        && signedBy(request.resource.data, 'createdBy') && signedBy(request.resource.data, 'updatedBy')
        // Un miembro siempre firma (solo el dueño puede venir de una app antigua sin firma)
        && (request.auth.uid == request.resource.data.userId || request.resource.data.get('createdBy', null) == request.auth.uid);
      // Solo se pueden cambiar estos campos (los gastos antiguos pueden traer otros y se respetan)
      // createdBy no se puede cambiar; updatedBy, si cambia, es quien escribe
      allow update: if owns(resource.data) && request.resource.data.userId == resource.data.userId && notDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'concept', 'category', 'date', 'refunds', 'updatedBy', 'receipt'])
        && validChanges(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedBy']) || request.resource.data.updatedBy == request.auth.uid)
        && (request.auth.uid == resource.data.userId || request.resource.data.get('updatedBy', null) == request.auth.uid);
    }

    // Reparto (categories), nóminas por mes (income), gastos fijos y la cartera de ahorros (wallet: saldo inicial y movimientos)
    // userId es el dueño del presupuesto (el uid del documento), también cuando escribe un miembro
    function validBudget(d, uid) {
      return d.userId == uid
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 50))
        && (!('fixedExpenses' in d) || (d.fixedExpenses is list && d.fixedExpenses.size() <= 50))
        && (!('income' in d) || (d.income is map && d.income.size() <= 600))
        // Sobrante pasado al mes siguiente (mes -> sobre -> €) y metas de ahorro de la cartera
        && (!('carry' in d) || (d.carry is map && d.carry.size() <= 600))
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 50))
        && (!('wallet' in d) || (d.wallet is map && d.wallet.keys().hasOnly(['initial', 'movements'])
              && (!('initial' in d.wallet) || d.wallet.initial is number)
              && (!('movements' in d.wallet) || (d.wallet.movements is list && d.wallet.movements.size() <= 2000))));
    }

    // Tema de color de cada persona (themes: uid -> id de tema). Cada uno solo cambia el suyo
    function okThemes(next, prev) {
      return next is map && next.size() <= 10
        && next.diff(prev).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in next) || (next[request.auth.uid] is string && next[request.auth.uid].size() <= 20));
    }

    // Crear y borrar el presupuesto, solo el dueño. members no está entre las claves que la app puede escribir
    match /budgets/{uid} {
      allow read: if canUse(uid);
      allow create: if request.auth != null && request.auth.uid == uid && notDemo()
        && request.resource.data.keys().hasOnly(['userId', 'categories', 'income', 'fixedExpenses', 'wallet', 'themes', 'carry', 'goals'])
        && validBudget(request.resource.data, uid)
        && (!('themes' in request.resource.data) || okThemes(request.resource.data.themes, {}));
      allow update: if canUse(uid) && notDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'categories', 'income', 'fixedExpenses', 'wallet', 'themes', 'carry', 'goals'])
        && validBudget(request.resource.data, uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['themes'])
            || okThemes(request.resource.data.themes, resource.data.get('themes', {})));
      allow delete: if request.auth != null && request.auth.uid == uid && notDemo();
    }

    // Foto del ticket de un gasto (receipts/{id del gasto}): imagen reducida en data URL, del mismo presupuesto
    match /receipts/{id} {
      allow read, delete: if canUse(resource.data.userId) && notDemo();
      allow create, update: if canUse(request.resource.data.userId) && notDemo()
        && request.resource.data.keys().hasOnly(['userId', 'data', 'createdBy'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.createdBy == request.auth.uid
        && (resource == null || resource.data.userId == request.resource.data.userId);
    }

    // Avisos en el móvil (pushSubs/{uid}): suscripciones push de cada persona (endpoint -> claves) y su presupuesto.
    // Solo las lee y escribe su dueño; el servidor las usa con la cuenta de servicio
    match /pushSubs/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && notDemo()
        && request.resource.data.keys().hasOnly(['budget', 'subs'])
        && request.resource.data.budget is string && canUse(request.resource.data.budget)
        && request.resource.data.subs is map && request.resource.data.subs.size() <= 10;
    }

    // Enlace de un miembro con el presupuesto que usa ({ budget: uid del dueño }). Solo lo escribe el script
    match /links/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // El resto (colecciones de la versión anterior: transactions, transfers, accounts, goals, finance)
    // queda cerrado por defecto
  }
}
