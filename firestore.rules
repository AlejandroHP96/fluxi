rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada documento es solo de su dueño y el dueño no se puede cambiar
    function owns(data) {
      return request.auth != null && data.userId == request.auth.uid;
    }

    // Gastos apuntados a mano o importados del CSV de Revolut
    match /expenses/{id} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.date is string && request.resource.data.concept is string;
      allow update: if owns(resource.data) && owns(request.resource.data)
        && request.resource.data.amount is number && request.resource.data.amount > 0;
    }

    // Presupuesto mensual (history) y categorías recordadas al importar (memory)
    match /budgets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // El resto (colecciones de la versión anterior: transactions, transfers, accounts, goals, finance)
    // queda cerrado por defecto
  }
}
