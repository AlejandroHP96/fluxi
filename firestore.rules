rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada documento es solo de su dueño y el dueño no se puede cambiar
    function owns(data) {
      return request.auth != null && data.userId == request.auth.uid;
    }

    // Cuenta demo pública (botón «Entrar como Tester»): funciona en memoria y nunca escribe en Firestore.
    // Debe coincidir con DEMO_UID de src/constants/demo.ts
    function notDemo() {
      return request.auth.uid != 'jTQDmVrbmDSX657q7Of8E0O0EfK2';
    }

    // Campos de un gasto: tipos y tamaños acotados (la cuenta demo es pública, así nadie mete basura enorme)
    function okAmount(d) { return d.amount is number && d.amount > 0 && d.amount < 1000000; }
    function okConcept(d) { return d.concept is string && d.concept.size() <= 200; }
    function okDate(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function okCategory(d) { return d.category is string && d.category.size() <= 100; }
    // Devoluciones del gasto (compras en conjunto): lista acotada
    function okRefunds(d) { return d.refunds is list && d.refunds.size() <= 30; }
    function validExpense(d) {
      return okAmount(d) && okConcept(d) && okDate(d) && okCategory(d);
    }
    // Al editar solo se validan los campos que cambian: un gasto antiguo con datos raros sigue siendo editable
    function validChanges(d, changed) {
      return (!changed.hasAny(['amount']) || okAmount(d))
        && (!changed.hasAny(['concept']) || okConcept(d))
        && (!changed.hasAny(['date']) || okDate(d))
        && (!changed.hasAny(['category']) || okCategory(d))
        && (!changed.hasAny(['refunds']) || okRefunds(d));
    }

    // Gastos apuntados a mano o importados del CSV de Revolut
    match /expenses/{id} {
      allow read: if owns(resource.data);
      allow delete: if owns(resource.data) && notDemo();
      allow create: if owns(request.resource.data) && notDemo()
        && request.resource.data.keys().hasOnly(['userId', 'amount', 'concept', 'category', 'date', 'createdAt'])
        && validExpense(request.resource.data);
      // Solo se pueden cambiar estos campos (los gastos antiguos pueden traer otros y se respetan)
      allow update: if owns(resource.data) && owns(request.resource.data) && notDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'concept', 'category', 'date', 'refunds'])
        && validChanges(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
    }

    // Reparto (categories), nóminas por mes (income), gastos fijos, categorías recordadas al importar (memory)
    // , la sesión del banco de Enable Banking (bank) y la cartera de ahorros (wallet: saldo inicial y movimientos)
    function validBudget(d) {
      return d.userId == request.auth.uid
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 50))
        && (!('fixedExpenses' in d) || (d.fixedExpenses is list && d.fixedExpenses.size() <= 50))
        && (!('income' in d) || (d.income is map && d.income.size() <= 600))
        && (!('memory' in d) || (d.memory is map && d.memory.size() <= 3000))
        && (!('bank' in d) || d.bank == null || (d.bank is map && d.bank.keys().hasOnly(['sessionId', 'validUntil', 'bankName', 'accounts'])))
        && (!('wallet' in d) || (d.wallet is map && d.wallet.keys().hasOnly(['initial', 'movements'])
              && (!('initial' in d.wallet) || d.wallet.initial is number)
              && (!('movements' in d.wallet) || (d.wallet.movements is list && d.wallet.movements.size() <= 2000))));
    }

    match /budgets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && notDemo()
        && request.resource.data.keys().hasOnly(['userId', 'categories', 'income', 'fixedExpenses', 'memory', 'bank', 'wallet'])
        && validBudget(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && notDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'categories', 'income', 'fixedExpenses', 'memory', 'bank', 'wallet'])
        && validBudget(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid && notDemo();
    }

    // El resto (colecciones de la versión anterior: transactions, transfers, accounts, goals, finance)
    // queda cerrado por defecto
  }
}
